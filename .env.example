# ============================================
# AITS 智能测试管理平台 - Docker Compose 环境变量
# ============================================
# 复制此文件为 .env 并修改配置

# 数据库类型：mysql 或 sqlite
# - mysql：使用 MySQL 服务（生产/团队部署推荐）
# - sqlite：使用本地 SQLite 文件（单机/开发调试，无需外部数据库服务）
DB_TYPE=mysql

# MySQL 配置（DB_TYPE=mysql 时使用）
DB_ROOT_PASSWORD=root123
DB_NAME=AITS_hub
DB_USER=aits
DB_PASSWORD=aits123

# SQLite 配置（DB_TYPE=sqlite 时使用）
# 相对路径以 backend 为根，推荐放在 data/ 下；也可填绝对路径
DB_PATH=data/aits.db

# 应用密钥（生产环境务必修改）
SECRET_KEY=aits-hub-dev-secret-key-change-in-production

# 默认大模型配置（可选，也可在平台界面配置）
DEFAULT_LLM_PROVIDER=openai_compatible
DEFAULT_LLM_BASE_URL=https://api.deepseek.com/v1
DEFAULT_LLM_API_KEY=
DEFAULT_LLM_MODEL=deepseek-chat

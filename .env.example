# ============================================
# AITS 智能测试管理平台 - Docker Compose 环境变量
# ============================================
# 复制此文件为 .env 并修改配置

# MySQL 配置
DB_ROOT_PASSWORD=root123
DB_NAME=AITS_hub
DB_USER=aits
DB_PASSWORD=aits123

# 应用密钥（生产环境务必修改）
SECRET_KEY=aits-hub-dev-secret-key-change-in-production

# 默认大模型配置（可选，也可在平台界面配置）
DEFAULT_LLM_PROVIDER=openai_compatible
DEFAULT_LLM_BASE_URL=https://api.deepseek.com/v1
DEFAULT_LLM_API_KEY=
DEFAULT_LLM_MODEL=deepseek-chat
